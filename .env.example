# Local development only. Copy to .env; never commit real secrets or personal data.
# Node.js 22.13+ (22.x). Production/staging must use separate Mongo replica sets,
# persistent private storage or a private Supabase S3 bucket, verified HTTPS origins,
# and separately escrowed keys.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=.runtime
TRUST_PROXY_HOPS=0

# Empty in development => transactional SQLite in DATA_DIR. No JSON DB fallback.
MONGODB_URI=
MONGODB_DB_NAME=

# Optional external file storage. Configure all five values or leave all blank.
# Use a private bucket and server-only S3 credentials from Supabase Storage settings.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=

# Different random 32-byte keys, each encoded as 64 hex characters.
# Development generates ignored local keys. Production can generate application-keys.json
# in DATA_DIR when none are supplied; DATA_DIR must be a persistent, protected volume.
# Back up that file separately. Never commit it or replace it after real use.
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_FILE=
AUDIT_HMAC_KEY=
AUDIT_HMAC_KEY_FILE=

# Configure either the signed webhook or Gmail SMTP for production/staging.
# Webhook receiver credentials stay in that receiving service.
OFFICE_ALERT_WEBHOOK_URL=
OFFICE_ALERT_WEBHOOK_SECRET=

# Gmail SMTP alternative. Generate an app password after enabling 2-Step Verification.
# Keep the app password in Render secrets; never commit or send it in chat.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
OFFICE_ALERT_EMAIL=
PRIVACY_ALERT_EMAIL=

# Development defaults only: 90-day enquiries, 365-day applications.
# Explicit school/legal approval and explicit periods required outside development.
FORM_RETENTION_DAYS=
ADMISSION_RETENTION_DAYS=
RETENTION_POLICY_APPROVED=false

# Preferred initial provisioning: npm run bootstrap -- --username ... --name ... --role ...
# Allowed first roles: system_admin and head_teacher, separately appointed people.
BOOTSTRAP_APPROVED=false
BOOTSTRAP_APPROVAL_REFERENCE=
BOOTSTRAP_PASSWORD_FILE=

# Optional first technical account only. No business authority or default password.
# Prefer the approved bootstrap command; remove these after secure provisioning.
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_PASSWORD=

# One-time, owner-approved first head-teacher account. Remove these after startup
# confirms account creation; never commit a real password or approval reference.
HEAD_TEACHER_USERNAME=
HEAD_TEACHER_NAME=
HEAD_TEACHER_PASSWORD=
HEAD_TEACHER_APPROVED=false
HEAD_TEACHER_APPROVAL_REFERENCE=

# Backups: stop all app instances/jobs and confirm the maintenance window first.
BACKUP_WRITES_PAUSED=false
MONGO_BACKUP_DIR=
MONGO_BACKUP_ENCRYPTION_KEY=
MONGO_BACKUP_ENCRYPTION_KEY_FILE=

# Explicit, isolated restore. Database name must end in _restore_test.
RESTORE_APPROVED=false
MONGODB_RESTORE_URI=
MONGODB_RESTORE_DB_NAME=
RESTORE_DATA_DIR=
SUPABASE_RESTORE_BUCKET=

# Optional legacy import from a fresh, encrypted pre-migration backup.
MONGO_MIGRATION_BACKUP_FILE=
MONGO_MIGRATION_APPROVED=false
MONGO_MIGRATION_STAGE_VERIFIED=false
