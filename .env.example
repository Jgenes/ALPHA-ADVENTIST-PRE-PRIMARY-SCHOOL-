# PHP 8.2+; local development only. Never commit credentials or personal data.
APP_ENV=development
BASE_URL=http://localhost:3000
DATA_DIR=.runtime
TRUST_PROXY_HOPS=0

# Blank => protected SQLite for development/tests. Production requires MySQL 8.
# Configure a full URL OR host/user/schema. The schema must already exist.
MYSQL_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PASSWORD_FILE=
MYSQL_DB_NAME=alpha_school
# Development: disabled. Production/staging: verify-full.
MYSQL_SSL_MODE=disabled
# Optional private-provider CA; otherwise use the system CA trust store.
MYSQL_TLS_CA_FILE=
MYSQL_SSL_CA=

# Selected production storage: persistent encrypted disk at DATA_DIR/storage.
STORAGE_DRIVER=local
# Alternative only: switch STORAGE_DRIVER to supabase and set all five values.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=

# Distinct random 32-byte keys encoded as 64 hex characters.
# Blank => generated once in protected DATA_DIR. Escrow separately from backups.
# Preserve these keys/application-keys.json during a Node-to-PHP cutover.
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_FILE=
AUDIT_HMAC_KEY=
AUDIT_HMAC_KEY_FILE=

# Preferred email integration: authenticated provider SMTP over verified TLS.
# Keep blank in development until configured. With SMTP_HOST set, defaults are
# port 587 and STARTTLS; use port 465 and SMTP_SECURITY=tls for implicit TLS.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Both recipients are required. Privacy/safeguarding reports go only to privacy.
# Legacy Gmail settings are still supported, but do not mix them with SMTP_*.
# Alternative to SMTP: an approved signed HTTPS office-alert webhook.
OFFICE_ALERT_WEBHOOK_URL=
OFFICE_ALERT_WEBHOOK_SECRET=
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
OFFICE_ALERT_EMAIL=
PRIVACY_ALERT_EMAIL=

# Development defaults: 90 days for forms; 365 days for applications.
# Production requires explicit periods and institutional approval.
FORM_RETENTION_DAYS=
ADMISSION_RETENTION_DAYS=
RETENTION_POLICY_APPROVED=false
PUBLIC_PREVIEW=false

# Optional initial environment provisioning; no default passwords.
ADMIN_USERNAME=system-admin
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=
HEAD_TEACHER_USERNAME=
HEAD_TEACHER_NAME=
HEAD_TEACHER_PASSWORD=
HEAD_TEACHER_APPROVED=false
HEAD_TEACHER_APPROVAL_REFERENCE=

# Approved CLI provisioning: never put a password on the command line.
BOOTSTRAP_APPROVED=false
BOOTSTRAP_APPROVAL_REFERENCE=
BOOTSTRAP_PASSWORD_FILE=

# Offline backup/restore/import only. Keys must differ from application keys.
BACKUP_WRITES_PAUSED=false
MYSQL_BACKUP_ENCRYPTION_KEY=
MYSQL_BACKUP_ENCRYPTION_KEY_FILE=
MYSQL_BACKUP_DIR=
RESTORE_APPROVED=false
MYSQL_RESTORE_URL=
MYSQL_RESTORE_DB_NAME=
RESTORE_DATA_DIR=
MYSQL_IMPORT_APPROVED=false
MYSQL_IMPORT_STAGE_VERIFIED=false
MYSQL_IMPORT_DRY_RUN=false
MYSQL_IMPORT_BACKUP_FILE=
