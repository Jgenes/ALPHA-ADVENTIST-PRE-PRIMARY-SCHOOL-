# Copy to .env for local development. Never add real credentials to this file.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=
TRUST_PROXY=false

# Use a separate database per environment.
MONGODB_URI=
MONGODB_DB_NAME=alpha_adventist_development
ADMIN_USERNAME=admin
ADMIN_NAME=School Administrator
ADMIN_PASSWORD=
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_FILE=

OFFICE_ALERT_WEBHOOK_URL=
FORM_RETENTION_DAYS=
MONGO_BACKUP_DIR=
MONGO_BACKUP_ENCRYPTION_KEY=
MONGO_BACKUP_ENCRYPTION_KEY_FILE=
MONGO_MIGRATION_BACKUP_FILE=
MONGO_MIGRATION_APPROVED=false
MONGO_MIGRATION_STAGE_VERIFIED=false
