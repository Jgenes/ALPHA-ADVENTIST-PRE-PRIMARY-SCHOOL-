# Production template only; copy values into your hosting secret settings.
# Do not commit a populated copy. No live credentials are included here.
APP_ENV=production
BASE_URL=
DATA_DIR=/var/data
TRUST_PROXY_HOPS=1

# Production uses MySQL, NEVER the local SQLite fallback.
# Set either MYSQL_URL (ending in /alpha_school) or MYSQL_HOST/MYSQL_USER/password.
MYSQL_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PASSWORD_FILE=
MYSQL_DB_NAME=alpha_school
MYSQL_SSL_MODE=verify-full
MYSQL_TLS_CA_FILE=
MYSQL_SSL_CA=
# Only for an approved one-time --create-database operation; remove afterwards.
MYSQL_SCHEMA_CREATE_APPROVED=false

# Selected storage: encrypted files on the persistent server disk.
# Mount /var/data persistently; only the application account may read/write it.
STORAGE_DRIVER=local
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_FILE=
AUDIT_HMAC_KEY=
AUDIT_HMAC_KEY_FILE=
# Blank keys are generated ONCE on the persistent disk. Escrow them separately.
# Preserve existing application keys if moving an already-used deployment.

# Your chosen hosting/transactional email provider. Enter credentials as secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Alpha School
# Both addresses must be explicitly approved by school management.
OFFICE_ALERT_EMAIL=
PRIVACY_ALERT_EMAIL=
# For implicit TLS instead, set SMTP_PORT=465 and SMTP_SECURITY=tls.

# Required institutional approval; do not enable with unreviewed retention periods.
FORM_RETENTION_DAYS=
ADMISSION_RETENTION_DAYS=
RETENTION_POLICY_APPROVED=false

# Initial accounts are provisioned by the approved CLI procedure, not defaults.
ADMIN_PASSWORD=
HEAD_TEACHER_USERNAME=
HEAD_TEACHER_NAME=
HEAD_TEACHER_PASSWORD=
HEAD_TEACHER_APPROVED=false
HEAD_TEACHER_APPROVAL_REFERENCE=
