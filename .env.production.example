# cPanel production example: replace every placeholder before use.
# Copy to .env outside the document root. PHP 8.2+ and MySQL 8 are required.
# Never commit passwords, personal data or a populated .env.
APP_ENV=production
BASE_URL=https://school.example.com
DATA_DIR=/home/CPANEL_USERNAME/alpha-school-private
TRUST_PROXY_HOPS=0

# Create an empty database and dedicated user first (cPanel or phpMyAdmin).
# cPanel-prefixed names such as account_alpha_school are supported.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PASSWORD_FILE=
MYSQL_DB_NAME=CPANEL_USERNAME_alpha_school
# Leave blank for automatic policy: local loopback may disable TLS;
# remote production connections require verify-full. Use your provider's CA.
MYSQL_SSL_MODE=
MYSQL_TLS_CA_FILE=
MYSQL_SSL_CA=
# Optional alternative to the fields above: mysql://user:password@host/database
MYSQL_URL=
# Not needed on cPanel; its database should already exist.
MYSQL_SCHEMA_CREATE_APPROVED=false

# Encrypted files are saved on this hosting account's private disk.
STORAGE_DRIVER=local
# Blank keys are generated once in DATA_DIR. Back them up separately and keep
# them unchanged when moving an existing installation.
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_FILE=
AUDIT_HMAC_KEY=
AUDIT_HMAC_KEY_FILE=

# Standard SMTP email, sent by PHP (no external email SDK).
# Leave all SMTP fields blank for local development without email.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
OFFICE_ALERT_EMAIL=
PRIVACY_ALERT_EMAIL=

# Development defaults are 90/365 days; production requires approved values.
FORM_RETENTION_DAYS=
ADMISSION_RETENTION_DAYS=
RETENTION_POLICY_APPROVED=false

# Initial approved accounts only; there are no default passwords.
ADMIN_USERNAME=system-admin
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=
HEAD_TEACHER_USERNAME=
HEAD_TEACHER_NAME=
HEAD_TEACHER_PASSWORD=
HEAD_TEACHER_APPROVED=false
HEAD_TEACHER_APPROVAL_REFERENCE=
BOOTSTRAP_APPROVED=false
BOOTSTRAP_APPROVAL_REFERENCE=
BOOTSTRAP_PASSWORD_FILE=

# Optional PHP backup and isolated restore commands.
BACKUP_WRITES_PAUSED=false
MYSQL_BACKUP_ENCRYPTION_KEY=
MYSQL_BACKUP_ENCRYPTION_KEY_FILE=
MYSQL_BACKUP_DIR=
RESTORE_APPROVED=false
MYSQL_RESTORE_URL=
MYSQL_RESTORE_DB_NAME=
RESTORE_DATA_DIR=
