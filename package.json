{
  "name": "alpha-adventist-browser-tests",
  "version": "2.0.0",
  "private": true,
  "description": "Optional browser-only development tools; the application runs entirely on PHP.",
  "scripts": {
    "start": "php -S 0.0.0.0:3000 -t public router.php",
    "dev": "php -S 0.0.0.0:3000 -t public router.php",
    "test": "php test/run.php && php test/integrations.php",
    "check": "php scripts/check.php",
    "test:mysql": "php test/run.php",
    "test:ui": "node scripts/ui-smoke.js && node scripts/auth-ui-smoke.js",
    "verify:integrations": "php scripts/verify-integrations.php",
    "init:production": "php scripts/init-production.php"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
